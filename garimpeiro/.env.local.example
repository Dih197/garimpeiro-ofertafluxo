# =============================================
# SHOPEE OPEN PLATFORM - AFFILIATE API
# =============================================
# Pegue suas chaves em: https://open.shopee.com/
# Copie este arquivo para .env.local e preencha
SHOPEE_APP_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_AFFILIATE_API=https://open-api.affiliate.shopee.com.br/graphql

# =============================================
# OPENAI (pra gerar roteiros com IA)
# =============================================
# Pegue em: https://platform.openai.com/api-keys
# Se vazio, sistema usa templates locais (funciona sem IA paga)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =============================================
# CRON / SECURITY
# =============================================
# Token pra proteger endpoint de cron diario
CRON_SECRET=mude-isso-pra-uma-string-aleatoria

# Modo demonstracao: usa dados mock se API Shopee nao estiver acessivel
# Mude para 'false' quando a API Affiliate estiver liberada na Open Platform
USE_MOCK_DATA=true
